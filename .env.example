# Environment variables for Netlify deploy
# Set these in your Netlify site dashboard: Site Settings > Environment Variables

# REQUIRED for Netlify Blob storage (reports map + photos)
# Generate at: https://app.netlify.com/user/settings#access-tokens
NETLIFY_ACCESS_TOKEN=your_netlify_personal_access_token_here

# Needed by the translate function (Gemini AI — free tier available)
GEMINI_KEY=your_gemini_api_key_here

# Needed ONLY for the one-time data migration from Airtable (migrate-data function)
AIRTABLE_TOKEN=your_airtable_token_here
AIRTABLE_BASE=your_airtable_base_id_here
AIRTABLE_TABLE=your_table_name_here
